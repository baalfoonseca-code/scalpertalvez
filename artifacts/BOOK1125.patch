+   BookDiagCell(row,BookDiagNumber(s.live_upper,identity)); BookDiagCell(row,BookDiagNumber(s.live_posrel,identity));
+   BookDiagCell(row,s.book_consulted?"CONSULTED":"NOT_EVALUATED");
