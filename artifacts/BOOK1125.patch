@@ -0,0 +1,5 @@
+#ifndef BOOK_ARMED_INPUTS_V1
+#define BOOK_ARMED_INPUTS_V1
+// Pure diagnostics: never used as an entry/exit/financial predicate.
+input bool Inp_EnableArmedDiagnostics = true;
