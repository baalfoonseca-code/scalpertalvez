+        built = subprocess.run(['g++', '-std=c++17', '-O2', '-Wall', '-Wextra', str(source), '-o', str(binary)], capture_output=True, text=True)
+        if built.returncode:
+            raise AssertionError(built.stderr)
+        result = subprocess.run([str(binary)], capture_output=True, text=True)
