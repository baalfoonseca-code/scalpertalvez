+   }
+   for(int k=0;k<BOOK_RESEARCH_TRACK_CAP;k++)
+      if(!gBookResearchPendingDispatches[k].used || gBookResearchPendingDispatches[k].id==id)
+      {gBookResearchPendingDispatches[k].used=true;gBookResearchPendingDispatches[k].id=id;
